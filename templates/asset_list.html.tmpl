<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>{{meta.level_id}} · 资产清单</title>
<style>
:root { --fg:#222; --muted:#888; --bg:#fafaf6; --line:#e8e8e0; --accent:#1a73e8; --code-bg:#f0f0ea; }
* { box-sizing:border-box; margin:0; padding:0; }
body { font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif; color:var(--fg); background:var(--bg); line-height:1.7; padding:40px 24px; max-width:980px; margin:0 auto; font-size:14px; }
.header { padding-bottom:20px; border-bottom:2px solid var(--fg); margin-bottom:24px; }
.header h1 { font-size:22px; font-weight:700; letter-spacing:.02em; margin-bottom:6px; }
.meta-bar { color:var(--muted); font-family:"JetBrains Mono","Consolas",monospace; font-size:11px; }
.meta-bar span { margin-right:16px; }
.section-label { font-size:11px; font-weight:600; color:var(--accent); text-transform:uppercase; letter-spacing:.08em; margin:24px 0 8px; padding-top:16px; border-top:1px solid var(--line); }
.overall-card { background:var(--code-bg); border-left:3px solid var(--accent); border-radius:0 4px 4px 0; padding:12px 16px; margin-bottom:8px; }
.chip-count { display:inline-block; font-size:12px; padding:2px 10px; border-radius:10px; background:#e8f0fe; border:1px solid #aecbfa; color:#1a56db; font-family:monospace; margin-left:8px; }
table { width:100%; border-collapse:collapse; margin-top:8px; }
th { font-size:11px; font-weight:600; color:var(--muted); text-align:left; padding:8px 10px; border-bottom:2px solid var(--line); background:var(--bg); white-space:nowrap; }
td { font-size:13px; padding:10px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
tr:last-child td { border-bottom:none; }
tr:hover td { background:#f5f5ef; }
.cat-chip { display:inline-block; font-size:11px; padding:2px 8px; border-radius:10px; background:var(--code-bg); color:var(--fg); border:1px solid var(--line); white-space:nowrap; }
.zone-chip { display:inline-block; font-size:11px; padding:2px 8px; border-radius:10px; background:#e8f0fe; border:1px solid #aecbfa; color:#1a56db; white-space:nowrap; }
.aid-empty { color:var(--muted); font-style:italic; }
.status-pending { display:inline-block; font-size:11px; padding:2px 8px; border-radius:3px; font-weight:500; background:#f3f4f6; color:#6b7280; }
.status-in_progress { display:inline-block; font-size:11px; padding:2px 8px; border-radius:3px; font-weight:500; background:#fef3c7; color:#d97706; }
.status-done { display:inline-block; font-size:11px; padding:2px 8px; border-radius:3px; font-weight:500; background:#dcfce7; color:#16a34a; }
.notes-text { color:var(--muted); font-size:12px; }
</style>
</head>
<body>

<div class="header">
  <h1>POI 资产清单</h1>
  <div class="meta-bar">
    <span><b>spec_id:</b> {{meta.spec_id}}</span>
    <span><b>level_id:</b> {{meta.level_id}}</span>
    <span><b>v</b>{{meta.version}}</span>
    <span><b>owner:</b> {{meta.owner}}</span>
    <span><b>type:</b> {{context.level_type}}</span>
  </div>
</div>

<div class="section-label">设计意图</div>
<div class="overall-card">{{context.intent}}</div>

<div class="section-label">
  资产清单
  <span class="chip-count" id="asset-count">...</span>
</div>

<table id="asset-table">
  <thead>
    <tr>
      <th>#</th>
      <th>资产名</th>
      <th>类别</th>
      <th>资产 ID</th>
      <th>引用区域</th>
      <th>状态</th>
      <th>备注</th>
    </tr>
  </thead>
  <tbody id="asset-tbody"></tbody>
</table>

<script>
(function() {
  var assets = {{assets}};

  var countEl = document.getElementById('asset-count');
  countEl.textContent = assets.length + ' 项';

  var tbody = document.getElementById('asset-tbody');

  var CAT_LABELS = {
    model_3d: '3D 模型', texture: '贴图', vfx: '特效粒子',
    audio: '音频', animation: '动画', interactive_object: '可交互物件',
    lighting: '灯具', other: '其他'
  };

  assets.forEach(function(a, i) {
    var tr = document.createElement('tr');

    var tdIdx = document.createElement('td');
    tdIdx.style.color = 'var(--muted)';
    tdIdx.style.fontFamily = 'monospace';
    tdIdx.style.fontSize = '11px';
    tdIdx.textContent = i + 1;
    tr.appendChild(tdIdx);

    var tdName = document.createElement('td');
    tdName.style.fontWeight = '600';
    tdName.textContent = a.name || '—';
    tr.appendChild(tdName);

    var tdCat = document.createElement('td');
    var catSpan = document.createElement('span');
    catSpan.className = 'cat-chip';
    catSpan.textContent = CAT_LABELS[a.category] || a.category || '—';
    tdCat.appendChild(catSpan);
    tr.appendChild(tdCat);

    var tdAid = document.createElement('td');
    var aid = (a.asset_id || '').trim();
    if (!aid || aid === '[待对接]' || aid === '[公司命名待对接]') {
      var aidSpan = document.createElement('span');
      aidSpan.className = 'aid-empty';
      aidSpan.textContent = '—';
      tdAid.appendChild(aidSpan);
    } else {
      tdAid.textContent = aid;
      tdAid.style.fontFamily = 'monospace';
      tdAid.style.fontSize = '12px';
    }
    tr.appendChild(tdAid);

    var tdZone = document.createElement('td');
    if (a.ref_zone_id) {
      var zSpan = document.createElement('span');
      zSpan.className = 'zone-chip';
      zSpan.textContent = a.ref_zone_id;
      tdZone.appendChild(zSpan);
    } else {
      tdZone.innerHTML = '<span style="color:var(--muted)">—</span>';
    }
    tr.appendChild(tdZone);

    var tdStatus = document.createElement('td');
    var st = a.status || 'pending';
    var stSpan = document.createElement('span');
    stSpan.className = 'status-' + st;
    stSpan.textContent = st;
    tdStatus.appendChild(stSpan);
    tr.appendChild(tdStatus);

    var tdNotes = document.createElement('td');
    if (a.notes) {
      var notesSpan = document.createElement('span');
      notesSpan.className = 'notes-text';
      notesSpan.textContent = a.notes;
      tdNotes.appendChild(notesSpan);
    } else {
      tdNotes.innerHTML = '<span style="color:var(--muted)">—</span>';
    }
    tr.appendChild(tdNotes);

    tbody.appendChild(tr);
  });
})();
</script>

</body>
</html>
